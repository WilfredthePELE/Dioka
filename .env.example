# DIOKA ENVIRONMENT TEMPLATE — no real secret keys are included.
# Copy to .env.local for local use, or enter values privately in Truehost.
# Supabase database and buckets are already provisioned for this project.
# Public origin used only for checkout return URLs.
DIOKA_SITE_URL=https://diokacraft.com

# Existing Supabase owner: contactus@diokacraft.com.
# Server-side administrator allowlist. Public sign-up cannot use these emails.
DIOKA_ADMIN_EMAILS=contactus@diokacraft.com
# Generate a random secret of 32+ characters. Remove after provisioning /admin.
DIOKA_BOOTSTRAP_SECRET=

# Preferred for serverless / multiple instances: apply all supabase/migrations in order, then supabase/seed.sql.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=https://plwxwgqlpurfvqgzcuin.supabase.co
# Paste your Supabase server secret/service-role key after the equals sign below.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative for one Node server: absolute directory on a persistent disk.
# Set this instead of Supabase; do not use ephemeral serverless storage.
DIOKA_DATA_DIR=

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
DIOKA_TRUST_PROXY=false
# Payments stay disabled until all three are configured and tested.
DIOKA_STORE_LIVE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth web client; both values stay on the server.
# Redirect URI: https://diokacraft.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Require shared Supabase persistence and trusted proxy before accepting purchases.
DIOKA_SCALE_MODE=false
# Global checkout admission per second. Increase only after provider quota/load verification.
DIOKA_CHECKOUT_RATE=20
